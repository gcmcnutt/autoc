	(text "ARTICLE 2 HARNESS  -  net labels, not drawn wires.  Netlist of record: harness-spec.md S6."
		(at 130.81 36.83 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "2a566460-c1d8-4f6e-85fd-6b577f977e2b")
	)
	(text "PROPOSED / NOT BUILT.  Items marked (!) in harness-spec.md S8 are unverified."
		(at 130.81 41.91 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "b8f3bce5-6297-4e1d-8c3c-9187bfd0ebb5")
	)
	(text "U1 jumpers: ELRS short-connect pad = BRIDGED (internal RX on UART2)."
		(at 120.65 118.11 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "4bd3693b-589b-4af9-869b-e83f8eead498")
	)
	(text "UART1 = xiao MSP   UART2 = ELRS CRSF   UART3 = spare   UART4 = GPS"
		(at 120.65 123.19 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "f6ece387-be19-47e3-8c1c-af3b3c29ed86")
	)
	(text "UART5 has no pads.  UART6 is RX-only.  M1-M4 are the only output pads."
		(at 120.65 128.27 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "ce86a3f8-20c6-4a62-8a2e-a784cbd75b75")
	)
	(text "U1 unit 1 = TOP face pads.  U1 unit 2 = BOTTOM face pads (ESC row + GPS row)."
		(at 120.65 135.89 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "8043fb3c-5aa8-4986-8746-3b6d59cf1cac")
	)
	(text "(!) XIAO 5V pin IS USB VBUS. FC rail plus a"
		(at 297.18 101.6 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "b11b6051-b5bd-4a68-8fb7-5039bd86cf5a")
	)
	(text "powered USB cable backfeeds the host port."
		(at 297.18 106.68 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "f44fa4b7-8c54-4665-843f-235724ebc6da")
	)
	(text "GPS FORWARD connector, left to right:"
		(at 297.18 199.39 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "b8a4bc14-bfcd-4805-86d1-292ba4be8100")
	)
	(text "red 5V | yellow RX | blue TX | green CL | white DA | black GND"
		(at 297.18 204.47 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "cbc6f916-43c8-4415-8048-3903d29712b9")
	)
	(text "(RX before TX - confirmed on the module.)"
		(at 297.18 209.55 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "818e37f2-8066-40da-8d69-04860777958c")
	)
	(text "M1,M2 = TIM8 -> timer_output_mode 7 SERVOS @ 50 Hz"
		(at 107.95 203.2 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "a69630e7-bd67-44f8-82e2-d2960596d1e4")
	)
	(text "M3 = TIM1 -> timer_output_mode 0 MOTORS, STANDARD (400 Hz)"
		(at 107.95 208.28 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "5a6b4462-b638-4670-8b9f-c774fd9e9550")
	)
	(text "GROUND TOPOLOGY  -  star point is the ESC pack-negative pad.  Four distinct WIRES, bonded only INSIDE a module:"
		(at 20.32 251.46 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "c6127a14-cd51-46e5-87d2-bb16e0f8855f")
	)
	(text "   GND_PACK   BT1 -  ->  U4 BAT-(60A).   U1 GND_B taps the same pads.   Carries motor return (0-40 A)."
		(at 20.32 256.54 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "8db1a563-5c63-4db7-87a5-0b077286df18")
	)
	(text "   GND_BEC    U4 BEC_GND  ->  S1/S2 GND.   Carries servo return (~2 A peak).   Bonded to GND_PACK INSIDE U4."
		(at 20.32 261.62 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "1e829f2e-5e77-449d-84df-8a217550cca9")
	)
	(text "   GND_XIAO   U1 GND_T1 -> U2 GND.      GND_GPS   U1 GND_B2 -> U3 GND.      Both bonded to GND_PACK INSIDE U1."
		(at 20.32 266.7 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "1d4af9b1-0943-40b3-8f41-158574de1643")
	)
	(text "(!) Do NOT take servo V+/GND from the FC - that routes servo return through the gyro's own voltage reference."
		(at 20.32 274.32 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "df7e9811-bae7-43c6-845d-db4f5dbd067b")
	)
	(text "(!) Do NOT land the ESC lead's BEC_GND on an FC pad - same problem, plus a loop.  Split the lead: only SIG goes to U1."
		(at 20.32 279.4 0)
		(effects
			(font (size 1.27 1.27))
			(justify left bottom)
		)
		(uuid "ff6c5658-4c50-4755-80cb-2b0e0bc57957")
	)
