# autoc.ini — NN neuroevolution configuration
# See specs/015-nn-training-improvements

# =============================================================================
# EVOLUTION PARAMETERS
# =============================================================================
# 028 more-rnn3: revert rnn2's search-dynamics tuning back to rnn1 baseline,
# keep only the budget extensions. Hypothesis: rnn1's selection/crossover
# config was already near-optimal for this architecture; rnn2 lost ground at
# every variation step due to TournamentSize=3 weakening selection. rnn3
# isolates "rnn1 config + more compute" — pop 5000 (held from rnn2) and
# gens 800 (extended further). If progress continues past rnn1's gen 400
# −30626, that earns a follow-on with a minimum-energy / non-linear-throttle
# objective layered on top.
PopulationSize                  = 5000      # 2026-06-02: back to original-M1 pop 5000 (with 6×49=294 scenarios)
NumberOfGenerations             = 800       # rnn1=400, rnn2=600, rnn3=800 — extension probe
CrossoverProbability            = 95        # reverted from rnn2's 80
CreationProbability             = 5         # % fresh random individuals (was 20)
TournamentSize                  = 5         # reverted from rnn2's 3 — primary suspect for rnn2 stall
SwapMutationProbability         = 15        # reverted from rnn2's 25
AddBestToNewPopulation          = 1         # reverted from rnn2's 3

# NN-specific
NNMutationSigma                 = 0.2       # initial mutation sigma
NNSigmaFloor                    = 0.05      # minimum sigma (0 = disabled)
NNCrossoverAlpha                = -1        # reverted from rnn2's 0.3 — uniform random per weight
# NNInitMethod: "xavier" or "uniform" (NOTE: currently unwired — NN init is hardcoded)
NNInitMethod                    = xavier

# Selection strategy (015): "sum" (legacy), "minimax", "lexicase"
SelectionMode                   = lexicase
LexicaseEpsilonMode             = mad        # 035 FR-003 — per-axis MAD-relative epsilon (energy bake)

# =============================================================================
# SIMULATION
# =============================================================================
ControlIntervalMsec             = 50       # t10: 20 Hz (must == SIM_TIME_STEP_MSEC; close-in bandwidth + 0.8s history — finding.md)
SimNumPathsPerGeneration        = 6
EvalThreads                     = 20

# Path generation: random, classic, line, computedPaths, longSequential,
#                  aeroStandard, progressiveDistance
PathGeneratorMethod             = aeroStandard

# Seeded random path generation
# 2026-05-31: reverted 2468 → 13337 (the 033 baseline value that produced
# the 2/3-climbers regime per specs/033/tasks.md). Reverting this in
# isolation as the diagnostic test for the 034 3/3-stuck regression: if
# test6 climbs from this seed, path-5 geometry under 2468 is the basin
# bias. If still stuck, the regression is elsewhere (T031 / per-tick
# state removal / fp ordering).
RandomPathSeedB                 = 13337

# RNG seed (-1 for time-based, run 3x to distinguish pattern from fluke)
# 2026-05-30: pinned to test4's resolved master seed (1780162827, logged
# as "Effective master seed" at run start) for a deterministic replay.
# Two-of-two stuck on 034 has us checking (a) is the GA deterministic
# under 034 (replay test4 from same seed → same trajectory), and (b) is
# the smoothness-removal cleanup subtly disturbing evolution dynamics.
# A bit-identical replay of test4 confirms (a); divergence here would
# indicate a determinism regression worth chasing before any more bakes.
Seed                            = -1

# Worker (crrcsim) configuration
WorkerPortOverride             = 0
WorkerProgram                  = ./scripts/crrcsim.sh

# =============================================================================
# SCENARIO VARIATIONS
# =============================================================================
# Wind scenario count (each with different wind seed for thermals/gusts)
# 2026-06-02: back to 49 (6 aeroStandard paths × 49 winds = 294 scenarios) —
# the original-M1 setup, now with the ±2.5σ variation clamps in place.
WindScenarios                   = 49

# Entry and wind variations (requires crrcsim support)
# 1=enabled, 0=disabled
EnableEntryVariations           = 1
EnableWindVariations            = 1
EnableRabbitSpeedVariations     = 1
EnableCraftVariations           = 1         # 034 US4 — see [Craft] section below for σ knobs
EnableHullCrashPenalty          = 0         # 038 T001 — score ×factor^(#hull-strike scenarios); M2 crash penalty (off=no-op pathgen)
ServoModelEnabled               = 1         # 037 servo v2 (PWM latch + slew): 50Hz latch w/ 0-20ms phase + slew ~24.2/s (autoc [-1,1] units)

# Gaussian sigma values (degrees for readability, converted to radians in code)
# Cone: nose direction deviates within a cone (no gimbal lock / Euler explosion)
EntryConeSigma                  = 18        # 037 T006: 2.5-sigma clamp -> 45 deg max half-angle (was 30)
EntryRollSigma                  = 30        # roll around body axis
EntrySpeedSigma                 = 0.06      # 037 T006: 2.5-sigma clamp -> 15% max speed delta (was 0.1)
WindDirectionSigma              = 45

# Entry position sigma in meters (0=disabled for xiao-like on-point start)
EntryPositionRadiusSigma        = 0.0
EntryPositionAltSigma           = 0.0

# =============================================================================
# 034 US4 — CRAFT VARIATIONS (per-scenario airframe parameter draws)
# =============================================================================
# Per-scenario airframe diversity (CG, drag, trim, thrust, pitch/roll
# effectiveness) on the CRRCSim chase craft. Sampled at scenario init from
# a craft-class PRNG seeded from deriveClassSubSeeds(scenarioSeed).craft;
# the worker scales draws via applyVariationScale, so craft RAMPS with
# wind/entry (same VariationRampStep below). Eval mode replays the saved
# genome.variation_scale exactly so an extracted weight reproduces its
# training-time airframe magnitude bit-for-bit.
#
# EnableCraftVariations is the macro-level disable (parallels
# EnableEntry/Wind/RabbitSpeed). When 0, the craft-class PRNG still
# advances per scenario (draw-and-discard preserves wind/entry/etc draws)
# but the drawn deltas are zeroed before reaching the FDM. Sigma=0 on a
# single axis is a finer-grained no-op for that one axis.
#
# Units: CraftCGSigma is in CRRCSim's CG_arm units (dimensionless
# chord-fraction / MAC; hb1_streamer nominal ≈ 0.28). CraftTrimSigma in
# rad. The rest are fractional multipliers (0.05 = ±5% one-sigma).
#
# EnableCraftVariations lives in the Variations enable group above
# (alongside Entry/Wind/RabbitSpeed) — search for it there.
CraftCGSigma                    = 0.02      # ~ ±7% MAC at hb1_streamer CG_arm=0.28
CraftDragSigma                  = 0.05      # ±5% CD_prof
CraftTrimSigma                  = 0.02      # ±1.15° pitch trim
CraftThrustSigma                = 0.05      # ±5% maxThrust (battery state, motor wear)
CraftPitchEffSigma              = 0.05      # ±5% pitch authority (servo / control horn slop)
CraftRollEffSigma               = 0.05      # ±5% roll authority (asymmetric servo response)
# 037 actuator-dynamics axes (absolute physical, in-FDM servo/thrust lag).
# Sigma in intrinsic units; center+clamp live in craft_variation.h.
CraftServoSlewSigma             = 4.0       # /s, autoc [-1,1] units (2026-06-12 unit fix: center ~24.2 = 82.5ms span transit, clamp 16-32; sigma doubled with the units)
CraftThrustTauSigma             = 0.060     # s, thrust lag tau sigma (center 0.150s, clamp 0.050-0.300)

# Variation landscape ramp (0=disabled, >0 = gens per step)
# OFF for baseline — reveals nondeterminism honestly
VariationRampStep               = 40        # 041 t6 (2026-08-20): ramp BACK ON -- reverses P0-5 for M1.
                                            # P0-5 took it off on M2 evidence. Four M1 runs now split 2/2 on
                                            # exactly this switch: ramp-off t4/t5 freeze at ~-15k by gen
                                            # ~360-376 with a byte-identical elite for ~100 gens; ramp-on
                                            # t1/038-t5 were still improving past gen 590. Tracking is NOT
                                            # broken (39.3 -> 11.3 m mean distance), so the stall reads as a
                                            # local minimum and the ramp is the perturbation that breaks it.
                                            # ⚠️ NOT PROVEN -- ramp-on runs are also graded on easier
                                            # scenarios early (scale 0->1), and raw score is length-
                                            # confounded. t6 is the single-variable test vs t5.
                                            # See specs/041-m2-depth/t5-wrap.md §2/§5.

# =============================================================================
# VARIABLE RABBIT SPEED
# =============================================================================
# Master switch: EnableRabbitSpeedVariations above. When 0, RabbitSpeedSigma
# is forced to 0 regardless of the value below.
RabbitSpeedNominal              = 12.0      # m/s (reduced from 13 — throttle headroom for maneuvering)
RabbitSpeedSigma                = 2.0       # m/s (68% within 10-14, real Vmax=17)
RabbitSpeedMin                  = 9.0       # m/s (well above stall ~7, keeps flying)
RabbitSpeedMax                  = 18.0      # m/s (real Vmax ~17, allows slight downhill)
RabbitSpeedCycleMin             = 3.0       # seconds (was 0.5 -- longer holds for distinct speed regimes)
RabbitSpeedCycleMax             = 7.0       # seconds (even short courses get 2-3 speed paradigms)

# =============================================================================
# STORAGE
# =============================================================================
S3Bucket                        = autoc-m1
; S3Profile                     = minio

# =============================================================================
# EVALUATION MODE
# =============================================================================
# 0 = normal NN evolution, 1 = evaluate saved weight file
EvaluateMode                    = 0
; NNWeightFile                  = nn_weights.dat

# =============================================================================
# FITNESS: POINT-ACCUMULATION SCORING (022, conical surface V4)
# =============================================================================
# Polar (conical) scoring surface with directional distance and clamped angle:
#   distance     = sqrt(along² + lateral²)
#   angle        = acos(-along / distance)   [0 = behind, π = ahead]
#   angle_clamp  = min(angle, π/2)           [ahead saturates at "sideways"]
#   dist_scale   = behind or ahead based on along sign
#   score        = 1 / (1 + (dist/dist_scale)² + (angle_clamp/cone)²)
#
# Tail-chase rewarded · lateral pinched (gravity fix) · ahead has real gradient
# (small distScaleAhead makes the distance term sharply penalize overshoots).
# See specs/022-tracking-cone-fitness/development-report.md for design history.
FitDistScaleBehind              = 7.0       # distance scale behind rabbit (m: -7m back = 0.5 threshold)
FitDistScaleAhead               = 2.0       # distance scale ahead of rabbit (m, sharp)
FitConeAngleDeg                 = 45.0      # angular half-decay from tail-chase line (deg)
FitStreakThreshold              = 0.5       # min stepPoints to maintain streak
FitStreakRampSec                = 5.0       # seconds to reach max multiplier

# --- 041 US4: envelope occupancy + specific-force inputs ---------------------
# Ablation gates for the T068 matrix: turn either half off WITHOUT a rebuild.
# Both default ON in code; stated explicitly here because they are recorded
# into the dmp (T043) and a run's dmp must say which arms were active.
EnableAccelInputs               = 1         # ACCEL_X/Y/Z populated (body specific force, g)
AccelScaleG                     = 8.0       # must match kAccelScale_g (nn_inputs.h); 11.2 g record -> 1.4

FitStreakMultiplierMax          = 5.0       # maximum streak multiplier (1x base + 4x bonus)

# --- 041 P2-3 — FLIGHT ARENA (ONE arena, both modes, both sides) -------------
# Was M1-implicit: the M1 termination check used a hardcoded 70/7/120 envelope
# while DIST_TO_BOUNDARY described FlightArena's 80/5/100 defaults. Both now
# read these keys, so what the policy is told and what ends the scenario are
# the same cylinder.
# ⛔ The band is ASYMMETRIC about the arm point: +50 m up, -30 m down. The arm
#    point is -SIM_INITIAL_ALTITUDE (35 m AGL), i.e. 30 m above the deck and NOT
#    at mid-band. resolveEngageArena derives the two extents separately from
#    exactly that, which is what makes it an identity on the virtual arena --
#    sim and flight the same arena by construction. arena_tests.cc pins it:
#    move a bound here without moving SIM_INITIAL_ALTITUDE and it fails.
FlightArenaRadius               = 70.0      # m horizontal
FlightArenaFloorAGL             = 25.0      # m AGL hard deck = arm - 30 m
FlightArenaCeilingAGL           = 105.0     # m AGL ceiling = arm + 50 m (band ASYMMETRIC: +50 up, -30 down)

HullCrashPenaltyFactor          = 0.5       # 038 T001 — hull geometric factor^K_hull; gated by EnableHullCrashPenalty (M1: off)
OobCrashPenaltyWeight           = 0.0       # 038 T001 t13 — OOB fraction penalty; 0 = off (M1 keeps score-stop)

# =============================================================================
# DEMETIC GROUPING (scenario assignment)
# =============================================================================
DemeticGrouping                 = 0
DemeSize                        = 1000
DemeticMigProbability           = 20

# =============================================================================
# 040 AIRFRAME OBSTRUCTION (FR-007/008/009) — chase self-occlusion geometry
# =============================================================================
# Replaces the single-AABB proxy, which modelled a 1" wing as a 0.25 m-thick
# brick AND placed the camera exactly on a box face (so every forward ray read
# as blocked). Three primitives now: thin wing slab, pod nose box, prop disc.
# The prop ATTENUATES rather than gates (FR-009).
#
# UNITS: METRES, body frame — like the rest of this file.
# DATUM: the propeller axle / back of the prop is station 0 = (0, 0, 0).
# AXES  (docs/COORDINATE_CONVENTIONS.md): +x forward through the nose,
#        +y out the RIGHT wing, +z DOWN through the belly.
#        Stations run AFT, so they are at NEGATIVE x. "Up" is NEGATIVE z.
#
# Measured 2026-07-28 (sketch + prop photo), converted from inches once:
#   wing   7" chord (LE station 6 -> TE station 13), 30" span, 1" thick,
#          underside 0.75" up from the axle
#   prop   Master Airscrew 5.5x4 two-blade -> r = 0.06985
#   camera IN THE WING LEADING EDGE: station 6 aft, 8" outboard, mid-thickness
#          at 1.25" up  =>  body (-0.152400, +0.203200, -0.031750)
#
# Present in EVERY ini even where the mode ignores them, so the config surface
# stays uniform and a mode switch never trips a missing key.
#
# DISABLED for now: Stage D (T043) moves the camera mount to the leading edge
# and turns this on. Enabling it against the legacy mount would model geometry
# the aircraft does not have.
AirframeObstructionEnabled      = 0

AirframeWingMinX                = -0.330200   # trailing edge
AirframeWingMinY                = -0.381000   # port tip
AirframeWingMinZ                = -0.044450   # wing top (up)
AirframeWingMaxX                = -0.152400   # leading edge
AirframeWingMaxY                = 0.381000    # starboard tip
AirframeWingMaxZ                = -0.019050   # wing underside

AirframeNoseMinX                = -0.152400
AirframeNoseMinY                = -0.038100
AirframeNoseMinZ                = -0.038100
AirframeNoseMaxX                = 0.0
AirframeNoseMaxY                = 0.038100
AirframeNoseMaxZ                = 0.038100

AirframePropPlaneX              = 0.0         # the datum plane
AirframePropAxisY               = 0.0
AirframePropAxisZ               = 0.0
AirframePropRadius              = 0.069850    # 5.5in two-blade
AirframePropAttenuation         = 0.18        # ASSUMED blade-over-pupil duty; FR-035
