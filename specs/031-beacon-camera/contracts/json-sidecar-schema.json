{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoc.local/specs/031-beacon-camera/json-sidecar-schema.json",
  "title": "Beacon-Camera Clip Sidecar (v1)",
  "description": "Per-clip metadata accompanying a Phase-1 .clip binary. See contracts/data-format.md for the binary contract.",
  "type": "object",
  "required": [
    "clip_id",
    "clip_file",
    "format_version",
    "iso_start_time",
    "sensor_model",
    "lens_spec",
    "capture_mode",
    "sensor_settings",
    "ambient",
    "pose_qualifier",
    "recording_mode"
  ],
  "additionalProperties": false,
  "properties": {
    "clip_id": {
      "type": "string",
      "description": "Session identifier — convention: <scenario>-<YYYY-MM-DD>-<NNN>, e.g. 'S6-2026-05-22-001' or 'US6-flight1-001'",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "clip_file": {
      "type": "string",
      "description": "Path to the .clip binary file, relative to the directory containing this sidecar"
    },
    "format_version": {
      "type": "integer",
      "description": "Must match the binary file header's format_version. Loader fails loud on mismatch (Principle V).",
      "const": 1
    },
    "iso_start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Wall-clock session start in ISO 8601"
    },
    "sensor_model": {
      "type": "string",
      "enum": ["OG0VA", "OV9281"]
    },
    "sensor_fw_rev": {
      "type": "string",
      "description": "Optional: sensor firmware revision if available via I2C"
    },
    "lens_spec": {
      "type": "object",
      "required": ["model", "h_fov_deg", "f_number", "filter_cwl_nm", "filter_fwhm_nm"],
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "description": "e.g. 'Commonlands-custom-120deg-F2-850bp' or 'm12lenses-PT-02120 + Edmund-65-679'"
        },
        "h_fov_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
        "f_number": {"type": "number", "exclusiveMinimum": 0},
        "filter_cwl_nm": {"type": "number", "minimum": 800, "maximum": 900},
        "filter_fwhm_nm": {"type": "number", "exclusiveMinimum": 0, "maximum": 50}
      }
    },
    "capture_mode": {
      "type": "object",
      "required": ["resolution", "fps", "bit_depth"],
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "type": "array",
          "items": {"type": "integer"},
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] — Phase 1 is always [320, 240]"
        },
        "fps": {
          "type": "integer",
          "enum": [240, 480]
        },
        "bit_depth": {
          "type": "integer",
          "enum": [8, 10]
        }
      }
    },
    "sensor_settings": {
      "type": "object",
      "required": ["exposure_us", "analog_gain", "digital_gain"],
      "additionalProperties": false,
      "properties": {
        "exposure_us": {"type": "number", "exclusiveMinimum": 0},
        "analog_gain": {"type": "number", "minimum": 1.0},
        "digital_gain": {"type": "number", "minimum": 1.0}
      }
    },
    "ambient": {
      "type": "string",
      "enum": ["indoor", "outdoor_cloudy", "outdoor_sun", "dusk", "dim"]
    },
    "range_qualifier": {
      "type": "string",
      "description": "Free-text or '<N>m'. Optional."
    },
    "pose_qualifier": {
      "type": "string",
      "enum": ["stationary", "hand_panned", "on_aircraft", "in_flight"]
    },
    "recording_mode": {
      "type": "string",
      "enum": ["bench_tethered", "flight_sd"]
    },
    "notes": {
      "type": "string",
      "description": "Free-text operator notes"
    },
    "in_flight_extras": {
      "type": "object",
      "description": "Required when recording_mode = flight_sd",
      "required": ["target_craft_id", "beacon_code_ids", "airframe_config", "intended_pattern"],
      "additionalProperties": false,
      "properties": {
        "target_craft_id": {"type": "string"},
        "beacon_code_ids": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 3},
          "minItems": 1,
          "maxItems": 2
        },
        "airframe_config": {"type": "string"},
        "intended_pattern": {"type": "string"},
        "ground_notes": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"recording_mode": {"const": "flight_sd"}}},
      "then": {"required": ["in_flight_extras"]}
    }
  ]
}
