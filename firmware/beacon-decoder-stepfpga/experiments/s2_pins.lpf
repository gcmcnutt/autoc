// S2 pins. Receiver clock = 12 MHz xtal on C1; emitter clock = internal OSCH (no pin).
IOBUF ALLPORTS IO_TYPE=LVCMOS33 ;
LOCATE COMP "clk12"    SITE "C1"  ;
FREQUENCY PORT "clk12" 12.000000 MHz ;
LOCATE COMP "sw1"      SITE "M7"  ;
LOCATE COMP "code_pin" SITE "P8"  ;   // I/O 14
LOCATE COMP "sync_pin" SITE "N8"  ;   // I/O 15
LOCATE COMP "k1"       SITE "L14" ;   // momentary K1 — hold to slow the emitter 100× (chips visible on LEDs)
IOBUF  PORT "k1" PULLMODE=UP ;
LOCATE COMP "spi_cs"   SITE "P3"  ;   // SPI_CS   → real J1 header (scope now; → real MCP3201 at S7)
LOCATE COMP "spi_sclk" SITE "M4"  ;   // SPI_SCLK → real J1
LOCATE COMP "spi_do"   SITE "N4"  ;   // SPI_SO / DOUT (mirrored OUT for scope; becomes INPUT in real mode)
LOCATE COMP "LEDs[0]"  SITE "N13" ;
LOCATE COMP "LEDs[1]"  SITE "M12" ;
LOCATE COMP "LEDs[2]"  SITE "P12" ;
LOCATE COMP "LEDs[3]"  SITE "M11" ;
LOCATE COMP "LEDs[4]"  SITE "P11" ;
LOCATE COMP "LEDs[5]"  SITE "N10" ;
LOCATE COMP "LEDs[6]"  SITE "N9"  ;
LOCATE COMP "LEDs[7]"  SITE "P9"  ;
